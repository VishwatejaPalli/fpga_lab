# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fpga_lab

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
ENCRYPTION_KEY=CHANGE_ME_TO_A_32_CHAR_ENCRYPTION_KEY

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
# Set to false only in development if using self-signed certificates (defaults to true)
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# ─── Access Control ──────────────────────────────────────────────────────────
# Comma-separated list of allowed email domains for signup, or * for all
ALLOWED_EMAIL_DOMAINS=*

# ─── File Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
WORKSPACE_DIR=./uploads/workspaces
MAX_UPLOAD_SIZE_MB=50

# ─── Sessions ────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30

# ─── Server ──────────────────────────────────────────────────────────────────
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── SSL / HTTPS (Optional — for native HTTPS in server.js) ─────────────────
# SSL_KEY_PATH=/etc/letsencrypt/live/lab.org/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/lab.org/fullchain.pem

# ─── Ngrok (Optional — for public access) ────────────────────────────────────
# NGROK_AUTHTOKEN=your-ngrok-authtoken
# NGROK_DOMAIN=your-subdomain.ngrok-free.dev

# ─── Development & Simulation ─────────────────────────────────────────────
# Set to true to bypass SSH/hardware checks when physical boards are offline
ENABLE_MOCK_HARDWARE=false

