# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fpga_lab

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# ─── Access Control ──────────────────────────────────────────────────────────
# Comma-separated list of allowed email domains for signup, or * for all
ALLOWED_EMAIL_DOMAINS=*

# ─── File Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
WORKSPACE_DIR=./uploads/workspaces
MAX_UPLOAD_SIZE_MB=50

# ─── Sessions ────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30

# ─── Server ──────────────────────────────────────────────────────────────────
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Ngrok (Optional — for public access) ────────────────────────────────────
# NGROK_AUTHTOKEN=your-ngrok-authtoken
# NGROK_DOMAIN=your-subdomain.ngrok-free.dev
